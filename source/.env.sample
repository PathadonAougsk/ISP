SUPABASE_URL=insert_supabase_url_here
SUPABASE_KEY=insert_supabase_key_here
SUPABASE_DB_URL=insert_supabase_db_url_here
# Only for a project still signing tokens with the legacy HS256 secret.
# One on a signing key (the default) publishes its public keys instead, and
# the backend verifies with those, so leave this out.
# SUPABASE_JWT_SECRET=insert_legacy_jwt_secret_here

NEXT_PUBLIC_SUPABASE_URL=insert_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=insert_next_public_supabase_anon_key_here
NEXT_PUBLIC_API_URL=http://localhost:8000
